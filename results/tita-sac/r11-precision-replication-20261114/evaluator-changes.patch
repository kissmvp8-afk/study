+def readiness(args):
+    """Readiness subcommand: delegate the step-4 checks to r11_resources.
+
+    r11_resources.check_readiness(root) is the single implementation of
+    the readiness checks; this handler only loads that module, writes the
+    report atomically, and maps the result to an exit code.
+    """
+    import importlib.util
+
+    root = Path(args.root).expanduser().resolve()
+    report = Path(args.report).expanduser()
+    resources = root / "r11_resources.py"
+    if not resources.is_file():
+        print("READINESS_FAIL r11_resources.py missing: " + str(resources), file=sys.stderr)
+        return 1
+    spec = importlib.util.spec_from_file_location("r11_resources", str(resources))
+    if spec is None or spec.loader is None:
+        print("READINESS_FAIL cannot load r11_resources.py", file=sys.stderr)
+        return 1
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    try:
+        result = module.check_readiness(root)
+    except Exception as exc:
+        print("READINESS_FAIL check_readiness raised: " + str(exc), file=sys.stderr)
+        return 1
+    result["generated_by"] = "r11_preflight.py readiness (delegates to r11_resources.check_readiness)"
+    text = json.dumps(result, indent=2, sort_keys=True) + "\n"
+    report.parent.mkdir(parents=True, exist_ok=True)
+    temporary = report.with_name("." + report.name + ".tmp")
+    temporary.write_text(text, encoding="utf-8")
+    temporary.replace(report)
+    status = result.get("status")
+    print("READINESS_" + str(status) + " " + str(report))
+    return 0 if status == "PASS" else 1
+
